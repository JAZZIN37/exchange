{
  "manifest_version": 3,
  "name": "NZ 교류신문 게시판 자동입력",
  "version": "1.0.0",
  "description": "신문 편집 페이지의 제목·본문·이미지를 안성초등학교 게시판 입력 화면에 채웁니다.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "https://YOUR-PRODUCTION-DOMAIN.example/*",
    "https://anseong-e.goean.kr/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:5000/*",
        "http://localhost:5000/*",
        "https://YOUR-PRODUCTION-DOMAIN.example/*",
        "https://anseong-e.goean.kr/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": { "default_title": "NZ 교류신문 자동입력" }
}
